diff --git a/scripts/ci/brake_self_merge.py b/scripts/ci/brake_self_merge.py
new file mode 100644
--- /dev/null
+++ b/scripts/ci/brake_self_merge.py
@@ -0,0 +56,4 @@
+WINDOW = timedelta(hours=2)
+HUMAN = "Owner"
+HUMAN_LOGIN = "owner-login"
+CORE_CLASSES = frozenset({"brake-change"})
@@ -0,0 +74,1 @@
+_ONE_WAY = re.compile(r"^T2 one-way (\S+)$")
@@ -0,0 +195,9 @@
+def decide(facts: Facts, now: datetime) -> Decision:
+    m = _ONE_WAY.match(facts.tier_line.strip())
+    if not m:
+        return Decision("not-one-way", f"class is {facts.tier_line.strip() or 'empty'}")
+    cls = m[1]
+    if cls in CORE_CLASSES:
+        return Decision(
+            "core", f"one-way {cls} is the brake's core: {HUMAN} merges", cls
+        )
@@ -0,0 +362,11 @@
+def _risk_line(number: int, ref: str) -> str:
+    key = re.search(r"([A-Z][A-Z0-9]*-[0-9]+)", ref)
+    script = Path(__file__).resolve().parent / "pr_risk_class.sh"
+    argv = ["bash", str(script), str(number), *([key[1]] if key else [])]
+    out = subprocess.run(argv, capture_output=True, text=True, timeout=600, check=False)
+    if out.returncode != 0:
+        raise RuntimeError(f"pr_risk_class.sh #{number} exit {out.returncode}")
+    lines = out.stdout.strip().splitlines()
+    if not lines:
+        raise RuntimeError(f"pr_risk_class.sh #{number} printed nothing")
+    return lines[0]
