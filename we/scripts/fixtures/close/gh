#!/usr/bin/env python3
"""A fake `gh` for test_worker_close.py.

$FAKE_GH is a JSON file `{"own": "o/r", "prs": {"o/r": [pr, …]}, "fail": ["o/x"]}`; a pr carries
gh's fields (number, state, title, headRefName, headRefOid, url, mergedAt). Every call appends its
argv to $FAKE_GH_LOG.

  pr list -R R --state all [--search K | --limit N] --json F   the PRs of R; R in `fail` exits 1
  pr list --head B --state S --json F                          the own repo's PRs on B in state S
  pr view REF [-R R] --json F                                  a PR by number or URL
  api repos/R                                                  {"default_branch": "main"}
  api repos/R/compare/main...SHA                               status "behind" when SHA is in
                                                               world["on_default"][R], else "diverged"
"""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as fh:
    fh.write(json.dumps(args) + "\n")
with open(os.environ["FAKE_GH"]) as fh:
    world = json.load(fh)


def opt(name):
    return args[args.index(name) + 1] if name in args else None


if args[:1] == ["api"]:
    parts = args[1].split("/")
    repo = "/".join(parts[1:3])
    if repo in world.get("fail", []):
        print("HTTP 502: gh broke", file=sys.stderr)
        sys.exit(1)
    if len(parts) == 3:
        print(json.dumps({"default_branch": "main"}))
        sys.exit(0)
    sha = parts[4].split("...", 1)[1]
    on = sha in world.get("on_default", {}).get(repo, [])
    print(json.dumps({"status": "behind" if on else "diverged"}))
    sys.exit(0)
repo = opt("-R") or world["own"]
if repo in world.get("fail", []):
    print("HTTP 502: gh broke", file=sys.stderr)
    sys.exit(1)
prs = world["prs"].get(repo, [])
if args[:2] == ["pr", "list"]:
    if opt("--head"):
        prs = [
            p
            for p in prs
            if p["headRefName"] == opt("--head") and p["state"] == opt("--state").upper()
        ]
    print(json.dumps(prs))
    sys.exit(0)
if args[:2] == ["pr", "view"]:
    ref = args[2]
    every = [p for ps in world["prs"].values() for p in ps]
    hit = [
        p for p in (prs if ref.isdigit() else every) if str(p["number"]) == ref or p["url"] == ref
    ]
    if not hit:
        print(f"no pull requests found for {ref}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(hit[0]))
    sys.exit(0)
sys.exit(9)
