#!/usr/bin/env python3
"""A fake `risk.command` for test_plan_tier.py, keeping the classifier contract.

Called `risk <base> <KEY>`: reads the plan docs/plans/<KEY>-story.md from HEAD's tree and the diff
<base>...HEAD; prints `T2 one-way money` when either names a `money/` path, else `T0`. Appends
{argv, cwd, self_hash} to $FAKE_RISK_LOG; $FAKE_RISK_EXIT exits with that code, $FAKE_RISK_LINE
prints that line 1 instead.
"""

import json
import os
import subprocess
import sys


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


me = os.path.abspath(sys.argv[0])
if os.environ.get("FAKE_RISK_LOG"):
    with open(os.environ["FAKE_RISK_LOG"], "a") as fh:
        record = {
            "argv": sys.argv[1:],
            "cwd": os.getcwd(),
            "self_hash": git("hash-object", me).stdout.strip(),
        }
        fh.write(json.dumps(record) + "\n")
if os.environ.get("FAKE_RISK_EXIT"):
    print("risk: refused", file=sys.stderr)
    sys.exit(int(os.environ["FAKE_RISK_EXIT"]))
if os.environ.get("FAKE_RISK_LINE"):
    print(os.environ["FAKE_RISK_LINE"])
    sys.exit(0)
base, key = sys.argv[-2], sys.argv[-1]
plan = git("show", f"HEAD:docs/plans/{key}-story.md")
if plan.returncode != 0:
    print(f"risk: no plan for {key}", file=sys.stderr)
    sys.exit(2)
diff = git("diff", "--name-only", f"{base}...HEAD").stdout.split()
one_way = "`money/" in plan.stdout or any(p.startswith("money/") for p in diff)
print("T2 one-way money" if one_way else "T0")
print("review: fake")
