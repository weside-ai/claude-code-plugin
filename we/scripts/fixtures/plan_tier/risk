#!/usr/bin/env python3
"""A fake `risk.command` for test_plan_tier.py, keeping the classifier contract.

Called `risk --plan <KEY>`: reads the plan docs/plans/<KEY>-story.md from origin/main; prints `T2`
(never a one-way class) when its Files name a `money/` path, else `T0`. $FAKE_RISK_NO_PLAN_MODE
refuses `--plan` as an unknown argument, as a classifier without the plan mode does; any other
call is refused the same way. Appends {argv, cwd, self_hash} to $FAKE_RISK_LOG; $FAKE_RISK_EXIT exits with that code, $FAKE_RISK_LINE
prints that line 1 instead.
"""

import json
import os
import subprocess
import sys


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


me = os.path.abspath(sys.argv[0])
if os.environ.get("FAKE_RISK_LOG"):
    with open(os.environ["FAKE_RISK_LOG"], "a") as fh:
        record = {
            "argv": sys.argv[1:],
            "cwd": os.getcwd(),
            "self_hash": git("hash-object", me).stdout.strip(),
        }
        fh.write(json.dumps(record) + "\n")
if os.environ.get("FAKE_RISK_EXIT"):
    print("risk: refused", file=sys.stderr)
    sys.exit(int(os.environ["FAKE_RISK_EXIT"]))
if os.environ.get("FAKE_RISK_LINE"):
    print(os.environ["FAKE_RISK_LINE"])
    sys.exit(0)
if sys.argv[1:2] == ["--plan"]:
    if os.environ.get("FAKE_RISK_NO_PLAN_MODE"):
        print("risk: unknown argument --plan (usage: risk [base] [KEY])", file=sys.stderr)
        sys.exit(2)
    plan = git("show", f"origin/main:docs/plans/{sys.argv[2]}-story.md")
    if plan.returncode != 0:
        print(f"risk: no plan for {sys.argv[2]}", file=sys.stderr)
        sys.exit(2)
    print("T2" if "`money/" in plan.stdout else "T0")
    print("review: fake")
    sys.exit(0)
print(f"risk: unknown argument {sys.argv[1]}", file=sys.stderr)
sys.exit(2)
