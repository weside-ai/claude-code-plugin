#!/usr/bin/env python3
"""A fake `gh` for test_board.py's moves.

`pr view <ref> [-R <owner>/<repo>] --json …` appends its argv to $FAKE_GH_LOG and looks the
arguments between `view` and `--json` (joined by spaces) up in the JSON file $FAKE_GH: an entry
`{"pr": {…}}` is printed, `{"exit": n}` exits n, a missing entry exits 1 like gh does.
`pr checks <ref> [-R …] --required --json …` prints the same entry's `checks` list and exits its
`checks_exit` (gh exits 1 on a failed and 8 on a pending check); without `checks` it says what gh
says on a PR with no required checks and exits 1.
`pr comment <ref> --body-file -` appends `{"comment": ref, "body": stdin}` to $FAKE_GH_LOG, prints
a comment URL and exits $FAKE_GH_COMMENT_EXIT (default 0).
"""

import json
import os
import sys

args = sys.argv[1:]
if args[:2] == ["pr", "comment"]:
    with open(os.environ["FAKE_GH_LOG"], "a") as fh:
        fh.write(json.dumps({"comment": args[2], "body": sys.stdin.read()}) + "\n")
    code = int(os.environ.get("FAKE_GH_COMMENT_EXIT") or 0)
    if code:
        print("GraphQL: Resource not accessible by integration", file=sys.stderr)
        sys.exit(code)
    print(args[2] + "#issuecomment-1")
    sys.exit(0)
with open(os.environ["FAKE_GH_LOG"], "a") as fh:
    fh.write(json.dumps(args) + "\n")
if args[:2] not in (["pr", "view"], ["pr", "checks"]) or "--json" not in args:
    sys.exit(9)
end = min(args.index(f) for f in ("--json", "--required") if f in args)
key = " ".join(args[2:end])
with open(os.environ["FAKE_GH"]) as fh:
    entry = json.load(fh).get(key)
if entry is None:
    print(f"no pull requests found for {key}", file=sys.stderr)
    sys.exit(1)
if entry.get("exit"):
    print("gh broke", file=sys.stderr)
    sys.exit(entry["exit"])
if args[1] == "checks":
    if "checks" not in entry:
        print("no required checks reported on the 'feat' branch", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(entry["checks"]))
    sys.exit(entry.get("checks_exit", 0))
print(json.dumps(entry["pr"]))
