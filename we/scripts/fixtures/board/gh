#!/usr/bin/env python3
"""A fake `gh` for test_board.py's moves.

`pr view <ref> [-R <owner>/<repo>] --json …` appends its argv to $FAKE_GH_LOG and looks the
arguments between `view` and `--json` (joined by spaces) up in the JSON file $FAKE_GH: an entry
`{"pr": {…}}` is printed, `{"exit": n}` exits n, a missing entry exits 1 like gh does.
"""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as fh:
    fh.write(json.dumps(args) + "\n")
if args[:2] != ["pr", "view"] or "--json" not in args:
    sys.exit(9)
key = " ".join(args[2 : args.index("--json")])
with open(os.environ["FAKE_GH"]) as fh:
    entry = json.load(fh).get(key)
if entry is None:
    print(f"no pull requests found for {key}", file=sys.stderr)
    sys.exit(1)
if entry.get("exit"):
    print("gh broke", file=sys.stderr)
    sys.exit(entry["exit"])
print(json.dumps(entry["pr"]))
