#!/usr/bin/env python3
"""A fake `claude` for test_board.py and test_cold_reader.py.

`agents --json` prints the file $FAKE_AGENTS (exit $FAKE_AGENTS_EXIT when set).
`-p …` appends {argv, stdin, cwd, cwd_files, env} to $FAKE_LOG, sleeps $FAKE_SLEEP seconds,
exits $FAKE_EXIT when set, else prints the file $FAKE_ANSWER.
"""

import json
import os
import sys
import time

args = sys.argv[1:]
if args[:2] == ["agents", "--json"]:
    if os.environ.get("FAKE_AGENTS_EXIT"):
        print("agents broke", file=sys.stderr)
        sys.exit(int(os.environ["FAKE_AGENTS_EXIT"]))
    with open(os.environ["FAKE_AGENTS"]) as fh:
        sys.stdout.write(fh.read())
    sys.exit(0)
if args[:1] == ["-p"]:
    stdin = sys.stdin.read()
    record = {
        "argv": args,
        "stdin": stdin,
        "cwd": os.getcwd(),
        "cwd_files": sorted(os.listdir(".")),
        "env": {k: os.environ.get(k) for k in ("CLAUDE_CONFIG_DIR", "WESIDE_COMPANION")},
    }
    with open(os.environ["FAKE_LOG"], "a") as fh:
        fh.write(json.dumps(record) + "\n")
    time.sleep(float(os.environ.get("FAKE_SLEEP", "0")))
    if os.environ.get("FAKE_EXIT"):
        print("model unavailable", file=sys.stderr)
        sys.exit(int(os.environ["FAKE_EXIT"]))
    with open(os.environ["FAKE_ANSWER"]) as fh:
        sys.stdout.write(fh.read())
    sys.exit(0)
sys.exit(9)
