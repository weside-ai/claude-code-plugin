#!/usr/bin/env bash
# we-worker — start and steer a process worker on the global login (references/worker-dispatch.md).
#   we-worker <name> [--bg [--queue [--queue-timeout <duration>]]] [--utility] [--limit <duration>] [--tree <path> | --here] [--branch <b>] [--account auto|<name>] [claude args...]
#                                  start a worker session named <name>
#   we-worker status [<name|id>] [--restart-waiters]
#                                  one line per worker, background or window (a session started with
#                                  WE_ROLE=worker or named by its tree's launcher marker, marked
#                                  `window`): id, name, pid, state, last=HH:MM (UTC
#                                  of its last assistant entry), then `usage-limit` or `auth` when that
#                                  entry is an API error of that kind, then `time-limit=HH:MM` (the
#                                  deadline of --limit, `reached` once past), then `waits: test-slot` while
#                                  a process of the worker is blocked on the host's test slot (from
#                                  /proc/locks); an exited worker that hit
#                                  the usage limit or an auth error gets a second line with its resume
#                                  command; then one `queued` line per queued start, its position
#                                  in its lane, `dead waiter` when its waiter is gone (it starts
#                                  nothing until --restart-waiters starts a new one; the entry keeps
#                                  its place) (scripts/worker_supervisor.py status_lines owns the line); last,
#                                  the machine's room for both lanes (`resource_line`)
#   we-worker stop <name|id>       removes a queued start of that name (its waiter ends), else
#                                  stops a worker (a background session with `claude stop`, a window
#                                  worker with SIGTERM to its pid) and waits until it is gone (30 s);
#                                  then ends what it left running (watchers, dev servers: its process
#                                  tree) and names each one; removes its settings and brief files; prints the
#                                  full session id and the resume command, and keeps them in
#                                  <state dir>/<name>.resume.json. A session that is no worker (no background,
#                                  no launcher marker, no WE_ROLE=worker: a master, a companion) refuses
#   we-worker checkpoint <name|id> commits a worker's tracked changes in its worktree (never on main; new files are named, not
#                                  committed) and pushes them
#                                  to wip/<branch without its type prefix> (before a quota pause);
#                                  refuses a worker that is working, busy or blocked on a prompt (one
#                                  writer per worktree); a file staged as new stays out like an untracked one
#   we-worker logs <name|id> [-n N] [--raw]
#                                  the last N (default 5) assistant texts from its transcript, plain;
#                                  --raw (or no transcript) prints `claude logs` with ANSI codes removed
#   we-worker waiting              sessions waiting on a permission prompt, with the tool call they wait on
#   we-worker gc [--apply]         removes the plugin's own files of sessions that no longer live
#                                  (settings, timer file, marker) and lists merged, clean worktrees
#                                  whose marker names no living worker, with their remove command;
#                                  Claude Code's job directories are only counted
#                                  (scripts/worker_supervisor.py); without --apply it only prints
#   we-worker close <KEY> [--pr <ref>] [--keep-worktrees] [--input FILE]
#                                  the one closing step after a merge: In Review once no open PR
#                                  carries the key and every repo of the plan has a merged one, the
#                                  story's trees, branches and worker files gone, the epic's updates-log
#                                  line; refuses a dirty or unmerged tree; idempotent
#   we-worker close --sweep [--apply]
#                                  merged PRs whose launcher marker still lies, each with its close
#                                  call; --apply runs them (scripts/worker_close.py owns both)
#   we-worker is-worker <name|id|sessionId>
#                                  exit 0 when that session is a worker (the one owner of the rule;
#                                  worker_launch.is_worker asks it): a background session, a worktree
#                                  whose launcher marker names it, or a process started with WE_ROLE=worker
# These verbs are no worker names. Whether a worker lives comes only from `claude agents --json` (pid and
# state), never from the wording of `claude logs` or `claude stop`.
#
# Start: every CLAUDE* variable of the calling session is dropped, CLAUDE_CONFIG_DIR above all: started
# from a pinned master, the worker would otherwise bill the pinned account. WESIDE_COMPANION is dropped
# too (a worker is never the companion of its starter), so is WE_ROLE_ID (nor its role), and
# WE_ROLE=worker is set; WE_HUMAN stays (it works for the same human); WE_STARTER names the starting
# session, the answer address of the worker's questions ("" when the starter has no name).
#   default  interactive in a tmux window <name> (the caller's tmux session, else the attached one)
#   --bg     a background session (`claude --bg`): listed in `claude agents`, steered with SendMessage
#   --limit  the time limit handed to the timer (default 3h; 90m, 2h30m; a bare number is minutes)
#   --tree <path>  start in that existing worktree (an integration tree, a finisher, a fix round)
#   --here   start where the caller stands: a worker that only reads (probe, walk, card, pre-sorter)
#   --branch <b>  the branch of a tree the launcher creates (default feat/<name>; workers.tree: own)
#   --account auto|<name>  the account the project's tool chooses (`.weside/config.json`
#            `agents.accounts_command`, run as `<cmd> --need critical|uncritical [--account <name>]`;
#            `worker_launch.py account`): the need is `critical` unless one of the brief's first
#            ten lines says `Account: uncritical`; the answer's `env` and `token_command` (as `apiKeyHelper`) go into
#            the worker's settings file, never onto a command line; a critical worker on a non-Claude
#            account, or --account without the option, refuses (exit 2); without --account nothing is asked
#   --queue  (with --bg) a start the concurrency cap refuses is queued in the state dir instead: a
#            detached waiter starts it once the check passes, first come first served across every
#            repo on the machine (a start without --queue waits behind a queued one too), and tells
#            the starter one line on start, failure or timeout (--queue-timeout, default 2h). From
#            a main checkout a queued start gets its own worktree, whatever `workers.tree` says.
#            The cap is the machine's: <state dir>/pool.json `max_busy_sessions` (default 8)
#   --utility  the utility lane: a fix round on an open PR's branch, a card, lens or review worker.
#            It counts against pool.json `max_utility_sessions` (default 5), not against the build
#            cap, waits in its own queue (never behind build starts), and starts only with room on
#            the machine. The 5h check and the room rule hold for both lanes. The lane is the
#            worker's WE_WORKER_LANE (settings file), marker and launched.jsonl line
#   Room:    a start of either lane needs room on the machine (pool.json): the own cgroup's working
#            set (memory.current - memory.stat file + memory.stat shmem) below `max_working_set_ratio`
#            (0.84) of memory.max (MemTotal without a limit), memory.pressure `full avg60` below
#            `max_pressure_full_avg60` (1); an unreadable one counts
#            as met (`n/a`). Without room a --bg start waits in its lane's queue, --queue or not, and
#            names the missed condition; a window start exits 4
#   Tree: without --tree or --here a start stays where the caller stands; only under `.weside/config.json`
#   `workers.tree: own` a start from the main checkout gets its own worktree (`worker_launch.py tree`:
#   the repo's `workers.add_worktree`, else `git worktree add <repo>-<name> -b <branch> origin/<default>`).
#   A start from a linked worktree or outside a repo, and a --resume, stay where they are. The tree is printed; a created or named tree gets the launcher's marker
#   (name, key, role, starter, tree, mode; `worker_launch.py marker`).
#   Supervisor: every start also starts `worker_supervisor.py spawn` (detached; its docstring owns what
#   it does); $WE_WORKER_NO_SUPERVISOR=1 skips it.
#   --resume/-r <id|name>  a short id or name resolves to the full session id (claude agents, else a
#                          stopped worker's <state dir>/<name>.resume.json, else a unique prefix of a
#                          session id in claude agents, the kept resume files or the transcripts);
#                          ambiguous (the candidates are named), unknown or still running (its pid
#                          lives: claude would start a copy) refuses without starting
# A start under a name a running session of any kind holds, or a tmux window already carries, refuses
# as well, naming that session's tree and state: steer it, or stop it first.
# A flag before the claude args that neither we-worker nor `claude --help` knows refuses (a typo like
# `--cwd` would otherwise reach claude as a prompt): run `we-worker <name> --tree <tree> …` instead.
# A start refuses (exit 2, before any claude call) a name that does not start with the story key (crew
# `naming.key`, `<key>-<chunk>`; `worker_launch.py check`). The brief is the last argument; a --bg
# start without one (none, or a flag last) refuses (exit 2; a window start may be empty), so does a last argument that is blank (`"$(cat <brief>)"` of an empty or unwritten
# file); a --resume needs none, its prompt is the brief when given. The brief also lands in
# <state dir>/<name>.brief.md, which the worker's SessionStart hook names (`worker_launch.py
# settings`): a SendMessage that reaches the new session before its start prompt pushes that prompt
# out, the file keeps it. Every start appends one line to <state dir>/launched.jsonl
# (`worker_launch.py marker` or `launched`). A brief line `Needs: <plugin or MCP server>, …` naming one that
# `workers.context` turns off refuses (exit 2; `worker_launch.py needs`). Without the plugin's worker_launch.py no worker
# starts. Every worker starts with `--settings <state dir>/<name>.settings.json` (`worker_launch.py
# settings`: its rights in this repo, the never-list, WE_ROLE, WE_STORY_KEY, WE_STARTER, WE_WORKER_NAME (its
# own name, for the signature of its commits and PRs) and WE_WORKER_LANE) and WE_STORY_KEY=<key>.
# The crew (`.weside/crew.json`, scripts/crew.py) adds, when set:
#   launch.allow_bypass true   --allow-dangerously-skip-permissions: the start mode stays
#                              permissions.defaultMode, bypass is one Shift+Tab away; without a crew
#                              value (no crew), $WE_WORKER_ALLOW_BYPASS=1 does the same
#   launch.worker_mode bypass  (else default) a --bg worker starts with --permission-mode bypassPermissions, because in
#                              the background nobody answers a prompt; a window worker keeps the
#                              default mode; a --permission-mode of the caller wins
#   launch.worker_timer <cmd>  the timer script (or $WE_WORKER_TIMER, which wins): `register` writes the
#                              worker's state, `arm` becomes a SessionStart hook of this worker alone;
#                              without one the worker starts with no timer
set -euo pipefail

usage() {
  echo "usage: we-worker <name> [--bg [--queue [--queue-timeout <duration>]]] [--utility] [--limit <duration>] [--tree <path> | --here] [--branch <b>] [--account auto|<name>] [claude args...] | gc [--apply] | close <KEY> [--pr <ref>] | close --sweep [--apply] | status [<name|id>] | stop <name|id> | checkpoint <name|id> | logs <name|id> [-n N] [--raw] | waiting  (help: we-worker --help)" >&2
  exit 2
}

crew_script() { plugin_script scripts/crew.py; }

# A script of the plugin: beside this file (the plugin's own copy), else in the installed plugin.
plugin_script() {
  local here
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  if [[ -f "$here/${1#scripts/}" ]]; then
    echo "$here/${1#scripts/}"
    return 0
  fi
  # we-install-resolver (scripts/validate-consistency.py keeps every copy equal)
  python3 -c 'if True:
    import json, os, sys
    f = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "plugins", "installed_plugins.json")
    want, run = sys.argv[1], "--exec" in sys.argv[2:3]
    try:
        rows = [e for k, v in json.load(open(f))["plugins"].items() if k.split("@")[0] == "we" for e in v]
    except Exception:
        sys.stderr.write("we plugin: " + f + " not readable; the plugin is not resolved\n")
        sys.exit(0 if run else 1)
    here = os.path.realpath(os.getcwd())
    def holds(e):
        p = os.path.realpath(e.get("projectPath") or "/nonexistent")
        return e.get("scope") in ("project", "local") and (here == p or here.startswith(p.rstrip("/") + "/"))
    near = sorted((e for e in rows if holds(e)), key=lambda e: len(os.path.realpath(e["projectPath"])))
    pick = (near or [e for e in rows if e.get("scope") == "user"] or [None])[-1]
    if pick is None:
        sys.stderr.write("we plugin: no we install in " + f + "\n")
        sys.exit(0 if run else 1)
    path = os.path.join(pick["installPath"], want)
    if run:
        os.execvp(sys.executable, [sys.executable, path] + sys.argv[3:])
    print(path)
' "$1" || true
}


# The crew's launch.<field> (crew.py launch), empty without a crew or crew.py.
crew_launch() {
  local resolver
  resolver=$(crew_script 2>/dev/null)
  [[ -n "$resolver" ]] || return 0
  python3 "$resolver" launch "$1" 2>/dev/null || true
}

# A crew file governs this directory (crew.py path finds one).
crew_found() {
  local resolver
  resolver=$(crew_script 2>/dev/null)
  [[ -n "$resolver" ]] && python3 "$resolver" path >/dev/null 2>&1
}

# Control always goes through the global profile, however the calling session is pinned.
_agents() { env -u CLAUDE_CONFIG_DIR claude agents --json 2>/dev/null; }
_projects() { echo "$HOME/.claude/projects"; }
_resolve() { # <name|id> -> "id pid state sessionId" of the newest background agent, else empty
  _agents | python3 -I -c 'import json,sys
k=sys.argv[1]; d=[a for a in json.load(sys.stdin) if a.get("kind")=="background" and k in (a.get("name"),a.get("id"))]
d.sort(key=lambda a:a.get("startedAt",0))
print(*(str(d[-1].get(f) or "-") for f in ("id","pid","state","sessionId")) if d else "")' "$1"
}

_resolve_any() { # <name|id|sessionId> -> "id pid kind sessionId state name cwd" (tab-separated: a name or cwd
  # may hold a space) of the newest agent of any
  # kind, else empty; an interactive row has no id: its sessionId stands in
  _agents | python3 -I -c 'import json,sys
k=sys.argv[1]; d=[a for a in json.load(sys.stdin) if k in (a.get("name"),a.get("id"),a.get("sessionId"))]
d.sort(key=lambda a:a.get("startedAt",0))
a=d[-1] if d else {}
a["id"]=a.get("id") or a.get("sessionId")
# an interactive row says busy/idle in status only; a background row blocked on a prompt says idle
# in status and blocked in state: blocked wins
a["state"]="blocked" if a.get("state")=="blocked" else (a.get("status") or a.get("state"))
print("\t".join(str(a.get(f) or "-") for f in ("id","pid","kind","sessionId","state","name","cwd")) if d else "")' "$1"
}
_starter() { # the calling session's name: $WE_WORKER_STARTER, else its row in claude agents
  [[ -n "${WE_WORKER_STARTER:-}" ]] && { echo "$WE_WORKER_STARTER"; return 0; }
  [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || return 0
  _agents | python3 -I -c 'import json,sys
print(next((a.get("name") or "" for a in json.load(sys.stdin) if a.get("sessionId")==sys.argv[1]), ""))' "$CLAUDE_CODE_SESSION_ID" 2>/dev/null || true
}
_is_worker() { # <kind> <pid> <cwd> [<name>]: a background session, a worktree whose launcher marker
  # names this session, or a process started as a worker (WE_ROLE=worker, readable on Linux); never a
  # master or companion, not even one that sits in a worker's tree. A background session whose settings
  # file (<state dir>/<name>.settings.json) sets WE_ROLE=master is a crew member `start.py launch`
  # started, no worker. Any session of the user can write that file, so this guards only against
  # mix-ups, never a right: no cheaper signal exists, a background session's /proc environment is
  # the `claude daemon`'s (whoever started the daemon), and its settings `env` applies inside it only.
  if [[ "$1" == background ]]; then
    python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if (d.get("env") or {}).get("WE_ROLE")=="master" else 1)' \
      "${WE_WORKER_STATE_DIR:-$HOME/.claude/we-state/workers}/${4:--}.settings.json" 2>/dev/null && return 1
    return 0
  fi
  local gd  # the marker as worker_launch.read_marker reads it: a JSON object whose name is <name>
  if [[ "$3" != - ]] && gd=$(git -C "$3" rev-parse --absolute-git-dir 2>/dev/null) &&
    python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if isinstance(d,dict) and d.get("name") and d.get("name")==sys.argv[2] else 1)' "$gd/we-worker.json" "${4:--}" 2>/dev/null; then
    return 0
  fi
  [[ "$2" != - && -r "/proc/$2/environ" ]] && tr '\0' '\n' <"/proc/$2/environ" | grep -qx 'WE_ROLE=worker'
}
_tree() { # <pid> -> "pid comm" of every descendant, one per line
  ps -e -o pid=,ppid=,comm= 2>/dev/null | python3 -I -c 'import sys
root=sys.argv[1]; kids={}; names={}
for l in sys.stdin:
    f=l.split(None,2)
    if len(f)<3: continue
    kids.setdefault(f[1],[]).append(f[0]); names[f[0]]=f[2].strip()
out=[]; todo=list(kids.get(root,[]))
while todo:
    c=todo.pop(); out.append(c); todo+=kids.get(c,[])
for c in out: print(c, names.get(c,"?"))' "$1"
}

name="${1:-}"
[[ -n "$name" ]] || usage
case "$name" in
  close)
    closer=$(plugin_script scripts/worker_close.py)
    [[ -n "$closer" && -f "$closer" ]] || { echo "we-worker: plugin we not installed (no worker_close.py)" >&2; exit 2; }
    shift
    exec python3 "$closer" "$@"
    ;;
  status)
    sup=$(plugin_script scripts/worker_supervisor.py)
    [[ -n "$sup" && -f "$sup" ]] || { echo "we-worker: plugin we not installed (no worker_supervisor.py)" >&2; exit 2; }
    shift
    sargs=()
    for a in "$@"; do
      case $a in --restart-waiters) sargs+=(--restart-waiters) ;; *) sargs+=(--key "$a") ;; esac
    done
    _agents | python3 "$sup" status ${sargs[@]+"${sargs[@]}"}
    exit
    ;;
  waiting)
    _agents | python3 -I -c 'import glob,json,os,sys
for x in json.load(sys.stdin):
    if x.get("waitingFor") != "permission prompt": continue
    fs = glob.glob(os.path.join(sys.argv[1], "*", "%s.jsonl" % x.get("sessionId")))
    last = None
    for line in (open(fs[0]) if fs else []):
        try: e = json.loads(line)
        except ValueError: continue
        m = e.get("message") or {}
        if e.get("type") == "assistant" and isinstance(m.get("content"), list):
            last = next((c for c in reversed(m["content"]) if isinstance(c, dict) and c.get("type") == "tool_use"), last)
    i = (last or {}).get("input") or {}
    print(x.get("name"), x.get("id"), (last or {}).get("name"), str(i.get("command") or i.get("to") or i.get("file_path") or "")[:120])' "$(_projects)"
    exit 0
    ;;
  is-worker) # <id|name>: exit 0 for a worker; the one owner of the rule (worker_launch.is_worker)
    [[ $# -ge 2 && -n "$2" ]] || usage
    IFS=$'\t' read -r id _pid kind _sid _state aname cwd <<<"$(_resolve_any "$2")" || true
    [[ -n "${id:-}" ]] && _is_worker "${kind:--}" "${_pid:--}" "${cwd:--}" "${aname:--}"
    exit
    ;;
  checkpoint)
    [[ $# -ge 2 && -n "$2" ]] || usage
    key=$2
    IFS=$'\t' read -r id _pid kind _sid state aname cwd <<<"$(_resolve_any "$key")" || true
    [[ -n "${id:-}" && "${cwd:-}" != - ]] || { echo "we-worker: no worker '$key' with a working directory in claude agents" >&2; exit 1; }
    _is_worker "${kind:--}" "${_pid:--}" "$cwd" "${aname:--}" || { echo "we-worker: '$key' ($id, $kind) is no worker; checkpoint commits only in a worker's tree" >&2; exit 1; }
    # one writer per worktree: a working worker commits in this tree itself
    case "${state:-}" in working | busy | blocked) echo "we-worker: '$key' ($id) is $state; checkpoint an idle or stopped worker (one writer per worktree)" >&2; exit 1 ;; esac
    branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null) || { echo "we-worker: $cwd is no git worktree" >&2; exit 1; }
    [[ "$branch" != HEAD ]] || { echo "we-worker: $cwd has a detached HEAD; nothing to name the wip branch after" >&2; exit 1; }
    case "$branch" in main | master) echo "we-worker: $cwd is on $branch; a checkpoint commits only on a worker's own branch" >&2; exit 1 ;; esac
    wip="wip/${branch#*/}"
    # tracked changes only: a new file may be a scratch dump or a local secret, never pushed unseen,
    # also when it is already staged (git add), so the commit names its paths instead of the index
    untracked=$({ git -C "$cwd" ls-files --others --exclude-standard
      git -C "$cwd" diff --cached --name-only --no-renames --diff-filter=A; } | head -5 | paste -sd ' ' -)
    tracked=()
    while IFS= read -r -d '' f; do tracked+=("$f"); done < <(git -C "$cwd" diff HEAD --name-only -z --no-renames --diff-filter=MDT)
    if [[ ${#tracked[@]} -eq 0 ]]; then
      echo "we-worker: $key has no tracked change; nothing to commit, its commits go to $wip"
    else
      if ! git -C "$cwd" commit -q -m "wip: checkpoint $key" -- "${tracked[@]}"; then
        echo "we-worker: the checkpoint commit in $cwd failed (a pre-commit hook?); nothing pushed" >&2
        exit 1
      fi
    fi
    git -C "$cwd" push -q origin "HEAD:refs/heads/$wip" ||
      { echo "we-worker: push of $wip failed; the commit stays local in $cwd" >&2; exit 1; }
    echo "we-worker: checkpoint $(git -C "$cwd" rev-parse --short HEAD) of $key pushed to $wip${untracked:+; not in it (new, untracked): $untracked}"
    exit 0
    ;;
  stop)
    [[ $# -ge 2 && -n "$2" ]] || usage
    key=$2
    sup=$(plugin_script scripts/worker_supervisor.py 2>/dev/null) || sup=""
    # a queued start of that name: removed, its waiter ends; a session holding the name still stops
    unqueued=0
    [[ -n "$sup" && -f "$sup" ]] && python3 "$sup" unqueue --name "$key" && unqueued=1
    IFS=$'\t' read -r id _pid kind sid _state aname _cwd <<<"$(_resolve_any "$key")" || true
    [[ $unqueued -eq 1 && -z "${id:-}" ]] && exit 0
    wtree=${_cwd:--}
    [[ -n "${id:-}" ]] || { echo "we-worker: no worker '$key' in claude agents" >&2; exit 1; }
    if ! _is_worker "${kind:--}" "${_pid:--}" "${_cwd:--}" "${aname:--}"; then
      echo "we-worker: '$key' ($id, $kind) is no worker (not background, no we-worker marker, no WE_ROLE=worker); a typo protects a master or companion here. To stop it anyway: claude stop $id${_pid:+ or kill $_pid}" >&2
      exit 1
    fi
    left=""
    [[ "${_pid:-}" != - ]] && left=$(_tree "$_pid")
    if [[ "${kind:-background}" == background ]]; then
      env -u CLAUDE_CONFIG_DIR claude stop "$id" >/dev/null 2>&1 || true
    elif [[ "${_pid:-}" != - ]]; then
      kill -TERM "$_pid" 2>/dev/null || true
    fi
    gone=""
    for _ in $(seq 1 "${WE_WORKER_STOP_WAIT:-30}"); do
      IFS=$'\t' read -r id2 pid2 _k _sid _state _name _cwd <<<"$(_resolve_any "$id")" || true
      if [[ -z "${id2:-}" || "${pid2:-}" == - ]] || ! kill -0 "$pid2" 2>/dev/null; then gone=1; break; fi
      sleep 1
    done
    ended=""
    mine=" $$ $(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ') "
    while read -r cpid comm; do
      if [[ -z "${cpid:-}" || "$mine" == *" $cpid "* ]] || ! kill -0 "$cpid" 2>/dev/null; then continue; fi
      # the pid was read before the stop: a reused pid runs another command now, never ended
      [[ "$(ps -o comm= -p "$cpid" 2>/dev/null | sed 's/^ *//')" == "$comm" ]] || continue
      kill -TERM "$cpid" 2>/dev/null && ended="${ended:+$ended, }$cpid $comm"
    done <<<"$left"
    if [[ -n "$gone" ]]; then
      [[ "${aname:--}" == - ]] || rm -f "${WE_WORKER_STATE_DIR:-$HOME/.claude/we-state/workers}/$aname".{settings.json,brief.md}
      echo "we-worker: $key ($id) stopped${ended:+; also ended: $ended}"
      if [[ "${sid:--}" != - && "${aname:--}" != - && -n "$sup" && -f "$sup" ]]; then
        targs=()
        [[ "$wtree" == - ]] || targs=(--tree "$wtree")
        python3 "$sup" stopped --name "$aname" --session "$sid" ${targs[@]+"${targs[@]}"} || true
      fi
      exit 0
    fi
    echo "we-worker: $key ($id) still running after ${WE_WORKER_STOP_WAIT:-30} s (pid $pid2; claude stop names no job for it? end it with: kill $pid2)${ended:+; ended: $ended}" >&2
    exit 1
    ;;
  logs)
    [[ $# -ge 2 && -n "$2" ]] || usage
    key=$2
    read -r id _pid _state sid <<<"$(_resolve "$key")" || true
    [[ -n "${id:-}" ]] || { echo "we-worker: no background worker '$key' in claude agents" >&2; exit 1; }
      shift 2
      n=5
      raw=0
      while [[ $# -gt 0 ]]; do
        case $1 in
          -n) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || usage; n=$2; shift 2 ;;
          --raw) raw=1; shift ;;
          *) usage ;;
        esac
      done
      if [[ $raw -eq 0 && "${sid:-}" != - ]] && python3 -I -c 'import glob,json,os,sys
fs = glob.glob(os.path.join(sys.argv[1], "*", "%s.jsonl" % sys.argv[2]))
if not fs: sys.exit(1)
out = []
for line in open(fs[0], encoding="utf-8", errors="replace"):
    try: e = json.loads(line)
    except ValueError: continue
    if e.get("type") != "assistant": continue
    c = (e.get("message") or {}).get("content")
    t = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text") if isinstance(c, list) else str(c or "")
    if t.strip(): out.append(((e.get("timestamp") or "")[11:16] or "--:--", t.strip()))
for hm, t in out[-int(sys.argv[3]):]:
    print("[%s] %s\n" % (hm, t))' "$(_projects)" "$sid" "$n"; then
        exit 0
      fi
      env -u CLAUDE_CONFIG_DIR claude logs "$id" 2>&1 | sed -E $'s/\x1b\\[[0-9;?]*[ -\\/]*[@-~]//g; s/\x1b\\][^\x07]*\x07//g; s/\r//g'
      exit "${PIPESTATUS[0]}"
    ;;
  gc)
    sup=$(plugin_script scripts/worker_supervisor.py)
    [[ -n "$sup" && -f "$sup" ]] || { echo "we-worker: plugin we not installed (no worker_supervisor.py)" >&2; exit 2; }
    exec python3 "$sup" gc --repo "$PWD" "${@:2}"
    ;;
  -h | --help)
    sed -n '2,/^set /{/^#/s/^# \{0,1\}//p}' "$0"
    exit 0
    ;;
  -*)
    echo "we-worker: '$name' is no worker name" >&2
    usage
    ;;
esac
shift

all=("$@")
bg=0
queue=0
queue_timeout=""
limit=3h
tree=""
here=0
branch=""
account=""
lane=build
while [[ $# -gt 0 ]]; do
  case $1 in
    --bg) bg=1; shift ;;
    --utility) lane=utility; shift ;;
    --here) here=1; shift ;;
    --tree) [[ $# -ge 2 && -n "$2" ]] || { echo "we-worker: --tree needs a worktree path" >&2; exit 2; }; tree=$2; shift 2 ;;
    --tree=*) tree=${1#--tree=}; shift ;;
    --branch) [[ $# -ge 2 && -n "$2" ]] || { echo "we-worker: --branch needs a branch name" >&2; exit 2; }; branch=$2; shift 2 ;;
    --branch=*) branch=${1#--branch=}; shift ;;
    --limit) [[ $# -ge 2 ]] || { echo "we-worker: --limit needs a duration (3h, 90m)" >&2; exit 2; }; limit=$2; shift 2 ;;
    --limit=*) limit=${1#--limit=}; shift ;;
    --account) [[ $# -ge 2 && -n "$2" ]] || { echo "we-worker: --account needs auto or an account name" >&2; exit 2; }; account=$2; shift 2 ;;
    --account=*) account=${1#--account=}; shift ;;
    --queue) queue=1; shift ;;
    --queue-timeout) [[ $# -ge 2 ]] || { echo "we-worker: --queue-timeout needs a duration (2h, 90m)" >&2; exit 2; }; queue_timeout=$2; shift 2 ;;
    --queue-timeout=*) queue_timeout=${1#--queue-timeout=}; shift ;;
    *) break ;;
  esac
done

# A living session under this name, of any kind, or a tmux window of that name: a second start
# would make two workers answer to one name (and write in one worktree).
if [[ -n "$tree" && $here -eq 1 ]]; then
  echo "we-worker: --tree and --here exclude each other" >&2
  exit 2
fi
if [[ $queue -eq 1 && $bg -eq 0 ]]; then
  echo "we-worker: --queue needs --bg (a waiter starts it later, without a terminal)" >&2
  exit 2
fi
IFS=$'\t' read -r held_id held_pid _k _sid held_state _n held_cwd <<<"$(_resolve_any "$name")" || true
if [[ -n "${held_id:-}" && "${held_pid:-}" != - ]] && kill -0 "$held_pid" 2>/dev/null; then
  echo "we-worker: a running session already holds the name $name ($held_id, pid $held_pid, state ${held_state:--}, tree ${held_cwd:--}); steer it with SendMessage, read it with 'we-worker logs $name', or 'we-worker stop $name' first" >&2
  exit 2
fi
held_window=$(tmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' 2>/dev/null | awk -v n="$name" '$2 == n {print $1; exit}' || true)
if [[ -n "$held_window" ]]; then
  echo "we-worker: the tmux window $held_window is already named $name (a window worker may live there); look at it, or close it first" >&2
  exit 2
fi


# --resume/-r with a short id or a name: resolve to the full session id first, or claude opens the
# session picker ("No sessions match") and the worker hangs without a word.
_resume_id() {
  local sid live="" sup
  sup=$(plugin_script scripts/worker_supervisor.py 2>/dev/null)
  [[ -n "$sup" && -f "$sup" ]] || { echo "we-worker: plugin we not installed (no worker_supervisor.py); --resume needs the full UUID" >&2; return 1; }
  # a full UUID, a name or job id in claude agents, a stopped worker's name, or a unique prefix of a
  # session id (worker_supervisor.resolve_session); ambiguous or unknown refuses, never a guess
  sid=$(_agents | python3 "$sup" resolve --key "$1") || return 1
  while read -r pid aid aname; do
    if [[ -n "${pid:-}" && "$pid" != - ]] && kill -0 "$pid" 2>/dev/null; then
      live="$aid $aname"
      break
    fi
  done < <(_agents | python3 -I -c 'import json,sys
for a in json.load(sys.stdin):
    if a.get("sessionId")==sys.argv[1]: print(a.get("pid") or "-", a.get("id") or "-", a.get("name") or "-")' "$sid")
  if [[ -n "$live" ]]; then
    read -r aid aname <<<"$live"
    echo "we-worker: --resume '$1': session $aname still runs (its pid lives); --resume would only start a copy. Look at it: claude attach $aid, or we-worker logs $aname" >&2
    return 1
  fi
  echo "$sid"
}
# Flags claude knows, from its own help; empty when the help cannot be read (then nothing is refused).
known_flags=$(env -u CLAUDE_CONFIG_DIR claude --help 2>/dev/null | grep -oE -- '--[a-z][a-z0-9-]*' | sort -u || true)
if [[ -n "$known_flags" && $# -gt 0 ]]; then
  last=$#
  [[ "${!#}" == --* ]] || last=$(($# - 1)) # the prompt is the last word unless it is a flag
  for arg in "${@:1:$last}"; do
    [[ "$arg" == --* ]] || continue
    flag=${arg%%=*}
    if ! grep -qxF -- "$flag" <<<"$known_flags"; then
      echo "we-worker: $flag is neither a we-worker flag (--bg, --queue, --queue-timeout, --utility, --limit, --tree, --here, --branch, --account) nor one claude knows; to start in another tree: we-worker $name --tree <tree> …" >&2
      exit 2
    fi
  done
fi
# The story key in the name: refused before anything starts.
wl=$(plugin_script scripts/worker_launch.py 2>/dev/null)
if [[ -z "$wl" || ! -f "$wl" ]]; then
  echo "we-worker: plugin we not installed (no worker_launch.py); no worker started" >&2
  exit 2
fi
resuming=0
resume_at=0 # the position of --resume/-r: its value is the session, never a brief
i=0
for a in "$@"; do
  i=$((i + 1))
  case $a in
    --resume | -r) resuming=1; resume_at=$i ;;
    --resume=* | --continue | -c) resuming=1 ;;
  esac
done
brief=""
[[ $# -gt 0 && "${!#}" != -* && ($resume_at -eq 0 || $# -gt $((resume_at + 1))) ]] && brief=${!#}
# A last argument that is there but blank is a brief that failed to arrive (`"$(cat brief)"` of a file
# a refused command never wrote): the worker would run without a task, so nothing starts.
if [[ $resuming -eq 0 && $# -gt 0 && -z "${brief//[[:space:]]/}" && "${!#}" != -* ]]; then
  echo "we-worker: the brief is empty (the last argument holds no text); write the brief first, then start $name; no worker started" >&2
  exit 2
fi
# No brief at all (no last argument, or a flag there) in the background: nobody hands a --bg or
# queued worker its task later, so nothing starts. A window worker may start empty: a human types there.
if [[ $resuming -eq 0 && $bg -eq 1 && -z "$brief" ]]; then
  echo "we-worker: no brief: the last argument is the worker's brief (we-worker $name … \"\$(cat <brief>)\"); no worker started" >&2
  exit 2
fi
key=$(python3 "$wl" check --name "$name" --prefix we-worker) || exit 2
# A brief that needs a plugin or MCP server workers.context turns off: refused before anything starts.
if [[ -n "$brief" ]]; then
  printf '%s' "$brief" | python3 "$wl" needs --repo "${tree:-$PWD}" --prefix we-worker || exit 2
fi
# The concurrency cap: busy sessions and room in the account rotation (.weside/config.json
# `workers`); a refusal names both values and exits 3, nothing starts; with --queue the start waits.
# Exit 4 is no refusal: the machine lacks room (the resource rule), a --bg start of either lane waits
# in its lane's queue without --queue; a waiter's rerun hands the 4 back as "still no room".
rc=0
python3 "$wl" capacity --repo "$PWD" --prefix we-worker --lane "$lane" || rc=$?
if [[ $rc -eq 4 && -n "${WE_WORKER_QUEUE_TURN:-}" ]]; then
  exit 4
fi
if [[ $rc -eq 4 && $bg -eq 0 ]]; then
  echo "we-worker: a window start cannot wait in the queue; start it with --bg, or again once there is room; no worker started" >&2
  exit 4
fi
if [[ ($rc -eq 3 && $queue -eq 1) || $rc -eq 4 ]]; then
  sup=$(plugin_script scripts/worker_supervisor.py 2>/dev/null)
  [[ -n "$sup" && -f "$sup" ]] || { echo "we-worker: plugin we not installed (no worker_supervisor.py); nothing queued" >&2; exit 3; }
  starter=$(_starter)
  qargs=("$name")
  skip=0
  for a in ${all[@]+"${all[@]}"}; do
    if [[ $skip -eq 1 ]]; then skip=0; continue; fi
    case $a in --queue | --queue-timeout=*) continue ;; --queue-timeout) skip=1; continue ;; esac
    qargs+=("$a")
  done
  qflags=()
  [[ -n "$brief" ]] && qflags+=(--has-brief)
  printf '%s\0' "${qargs[@]}" | python3 "$sup" queue --name "$name" --tree "$PWD" ${starter:+--starter "$starter"} \
    ${queue_timeout:+--timeout "$queue_timeout"} --lane "$lane" ${qflags[@]+"${qflags[@]}"}
  exit
fi
[[ $rc -eq 0 ]] || exit $rc
# The account, chosen before a tree or marker exists: a refusal leaves nothing behind.
account_file=""
if [[ -n "$account" ]]; then
  need=$(printf '%s' "$brief" | python3 "$wl" account-need)
  account_file="${WE_WORKER_STATE_DIR:-$HOME/.claude/we-state/workers}/$name.account.json"
  account_err="$account_file.err"
  mkdir -p "${account_file%/*}"
  chosen=$(env -u CLAUDE_CONFIG_DIR python3 "$wl" account --repo "${tree:-$PWD}" --account "$account" --need "$need" --out "$account_file" 2>"$account_err") || {
    echo "we-worker: $(sed 's/^worker_launch: //' "$account_err"); no worker started" >&2
    rm -f "$account_file" "$account_err"
    exit 2
  }
  rm -f "$account_err"
  echo "we-worker: $name runs on $chosen"
fi
cargs=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --resume | -r)
      [[ $# -ge 2 && "$2" != -* ]] || { echo "we-worker: $1 needs a session id" >&2; exit 2; }
      rid=$(_resume_id "$2") || exit 2
      cargs+=("$1" "$rid")
      shift 2
      ;;
    --resume=*) rid=$(_resume_id "${1#--resume=}") || exit 2; cargs+=("--resume=$rid"); shift ;;
    *) cargs+=("$1"); shift ;;
  esac
done
set -- ${cargs[@]+"${cargs[@]}"}

# The worker's tree: named (--tree), the caller's (--here, a linked worktree, no repo, a resume), or
# created beside the main checkout. A created or named tree carries the launcher's marker.
mark=0
if [[ -n "$tree" ]]; then
  tree=$(cd "$tree" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) ||
    { echo "we-worker: --tree: no git worktree there; no worker started" >&2; exit 2; }
  if python3 "$wl" tree --main-checkout --repo "$tree" --name "$name" >/dev/null 2>&1; then
    echo "we-worker: --tree $tree is the main checkout, no worker's tree; a reading worker starts there with --here; no worker started" >&2
    exit 2
  fi
  mark=1
elif [[ $here -eq 0 && $resuming -eq 0 ]]; then
  rc=0
  # a queued start (--queue, or its waiter's rerun) gets its own tree under any workers.tree
  qtree=()
  [[ $queue -eq 1 || -n "${WE_WORKER_QUEUE_TURN:-}" ]] && qtree=(--queued)
  created=$(python3 "$wl" tree --auto ${qtree[@]+"${qtree[@]}"} --repo "$PWD" --name "$name" ${branch:+--branch "$branch"}) || rc=$?
  case $rc in
    0) tree=$created; mark=1 ;;
    3) ;;
    *) echo "we-worker: no tree for $name (above); no worker started" >&2; exit 2 ;;
  esac
fi
if [[ -n "$tree" ]]; then
  cd "$tree"
fi
echo "we-worker: $name works in $PWD"
starter=$(_starter)
mode="tmux"
[[ $bg -eq 1 ]] && mode="bg"
if [[ $mark -eq 1 ]]; then
  python3 "$wl" marker --tree "$PWD" --name "$name" --key "$key" --role worker ${starter:+--starter "$starter"} --mode "$mode" --lane "$lane" \
    ${CLAUDE_CODE_SESSION_ID:+--starter-session "$CLAUDE_CODE_SESSION_ID"} ||
    { echo "we-worker: the marker of $name could not be written in $PWD; no worker started" >&2; exit 2; }
else
  # no marker in a tree that is not the worker's own; the starter log still records the start
  python3 "$wl" launched --name "$name" --key "$key" ${starter:+--starter "$starter"} --lane "$lane" \
    ${CLAUDE_CODE_SESSION_ID:+--starter-session "$CLAUDE_CODE_SESSION_ID"} || true
fi

extra=()
# The crew's value wins; only where no crew answers (no crew file) does the variable count.
allow=$(crew_launch allow_bypass)
if ! crew_found && [[ "${WE_WORKER_ALLOW_BYPASS:-}" == 1 ]]; then allow=true; fi
[[ "$allow" == true ]] && extra+=(--allow-dangerously-skip-permissions)
mode_given=0
for a in "$@"; do [[ "$a" == --permission-mode || "$a" == --permission-mode=* ]] && mode_given=1; done
if [[ $bg -eq 1 && $mode_given -eq 0 && "$(crew_launch worker_mode)" == bypass ]]; then
  extra+=(--permission-mode bypassPermissions)
fi
hook=""
timer=${WE_WORKER_TIMER:-$(crew_launch worker_timer)}
timer=${timer/#\~/$HOME}
if [[ -n "$timer" ]]; then
  if [[ -f "$timer" ]]; then
    # Before the CLAUDE* variables go: the caller's session id names the starter.
    state=$(python3 -I "$timer" register --name "$name" --limit "$limit" --mode "$mode" \
      --starter-session "${CLAUDE_CODE_SESSION_ID:-}" ${WE_WORKER_STARTER+--starter "$WE_WORKER_STARTER"}) ||
      { echo "we-worker: the timer $timer refused to register $name; no worker started" >&2; exit 2; }
    hook=$(printf 'python3 -I %q arm %q' "$timer" "$state")
  else
    echo "we-worker: warning: timer $timer not found; $name starts without a time limit" >&2
  fi
fi

# The worker's rights and never-list as its settings file, the timer's hook in it; the brief decides
# whether the ticketing plugin loads (`worker_launch.py ticketing_unneeded`), read from the worker's
# own config dir (the global login, without CLAUDE_CONFIG_DIR).
settings_file="${WE_WORKER_STATE_DIR:-$HOME/.claude/we-state/workers}/$name.settings.json"
printf '%s' "$brief" | env -u CLAUDE_CONFIG_DIR python3 "$wl" settings --repo "$PWD" --key "$key" --name "$name" --out "$settings_file" --brief-stdin ${hook:+--session-start "$hook"} ${starter:+--starter "$starter"} --lane "$lane" \
  ${account_file:+--account-file "$account_file"} >/dev/null ||
  { echo "we-worker: the settings of $name could not be written; no worker started" >&2; rm -f ${account_file:+"$account_file"}; exit 2; }
[[ -z "$account_file" ]] || rm -f "$account_file"
extra+=(--settings "$settings_file")

# The supervisor inherits the starter's inbox socket and token from this shell before they go.
if [[ "${WE_WORKER_NO_SUPERVISOR:-}" != 1 ]]; then
  sup=$(plugin_script scripts/worker_supervisor.py 2>/dev/null)
  if [[ -n "$sup" && -f "$sup" ]]; then
    python3 "$sup" spawn --name "$name" --tree "$PWD" >/dev/null ||
      echo "we-worker: warning: no supervisor for $name; its stop reaches nobody" >&2
  fi
fi

for var in $(compgen -e | grep -E '^CLAUDE' || true); do unset "$var"; done
unset WESIDE_COMPANION WE_ROLE_ID WE_WORKER_QUEUE_TURN
export WE_ROLE=worker WE_STORY_KEY="$key" WE_STARTER="${starter:-}" WE_WORKER_NAME="$name" WE_WORKER_LANE="$lane"

if [[ $bg -eq 1 ]]; then
  exec claude --bg -n "$name" ${extra[@]+"${extra[@]}"} "$@"
fi
# The window's tmux session: the caller's own, else the attached one (a background session has no
# $TMUX). Neither: start in this terminal, else refuse rather than run once inside a Bash tool.
target=""
if [[ -z "${TMUX:-}" ]]; then
  target=$(tmux list-sessions -F '#{session_attached} #{session_name}' 2>/dev/null | awk '$1 > 0 {print $2; exit}' || true)
  if [[ -z "$target" ]]; then
    [[ -t 0 ]] && exec claude -n "$name" ${extra[@]+"${extra[@]}"} "$@"
    echo "we-worker: no tmux and no terminal; use --bg or start inside tmux" >&2
    exit 1
  fi
  target="$target:"
fi
args=$(printf ' %q' -n "$name" ${extra[@]+"${extra[@]}"} "$@")
# tmux starts the window with the server's environment, not this shell's: clear it there.
human=${WE_HUMAN:+ WE_HUMAN=$(printf '%q' "$WE_HUMAN")}
tmux new-window -d ${target:+-t "$target"} -n "$name" "env -u CLAUDE_CONFIG_DIR -u WESIDE_COMPANION -u WE_ROLE_ID$human WE_ROLE=worker WE_STORY_KEY=$(printf '%q' "$key") WE_STARTER=$(printf '%q' "${starter:-}") WE_WORKER_NAME=$(printf '%q' "$name") WE_WORKER_LANE=$lane claude$args"
echo "we-worker: $name starts in tmux window $name${target:+ of ${target%:}} (global login${timer:+; time limit $limit})"
