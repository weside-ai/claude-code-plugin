#!/usr/bin/env bash
# wclaude — start Claude Code as a weside Companion (references/companion-session.md).
# Lists the members of the nearest .weside/council.json (searched upwards from the cwd),
# then runs `WESIDE_COMPANION=<Name> claude --name <Name> <your args>` (no --name if you pass one).
#   wclaude                 menu, then claude
#   wclaude --resume        menu, then claude --resume (every other argument goes to claude)
#   wclaude -c              menu, then claude -c (claude's own --continue)
#   wclaude --as <Name> ... no menu; the rest goes to claude
#   wclaude --pin ...       start through $WCLAUDE_PIN instead of claude (combines with --as)
# Choice 0 starts claude with the companion pin cleared (WESIDE_COMPANION empty = no companion).
# Every session it starts is a master: WE_ROLE=master. Without --pin it runs on the same login as a
# plain `claude` and follows your account switcher. WCLAUDE_PIN names one executable that takes
# claude's arguments and holds the session on one account (e.g. a claude-swap profile); --pin
# without it is refused.
# Portable to macOS bash 3.2: no mapfile, no empty-array expansion under `set -u`.
set -euo pipefail

usage() {
  echo "usage: wclaude [--as <Name>] [--pin] [claude arguments...]" >&2
  exit 2
}

pick=""
picked=0
pin=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --as)
      [[ $# -ge 2 && -n "$2" ]] || usage
      pick=$2
      picked=1
      shift 2
      ;;
    --pin)
      pin=1
      shift
      ;;
    *) break ;;
  esac
done
launch=claude
if [[ $pin -eq 1 ]]; then
  [[ -n "${WCLAUDE_PIN:-}" ]] || { echo "wclaude: --pin needs WCLAUDE_PIN (the command that pins an account)" >&2; exit 2; }
  launch=$WCLAUDE_PIN
fi
export WE_ROLE=master

find_council() {
  local d=$PWD
  while :; do
    if [[ -f "$d/.weside/council.json" ]]; then
      echo "$d/.weside/council.json"
      return 0
    fi
    [[ "$d" == "/" || -z "$d" ]] && return 1
    d=$(dirname "$d")
  done
}

# One line per member: "<name>\t<title, else role>". Members without a name are skipped.
list_members() {
  python3 - "$1" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        members = json.load(fh).get("members") or {}
except (OSError, ValueError, AttributeError) as exc:
    sys.stderr.write("wclaude: cannot read %s: %s\n" % (sys.argv[1], exc))
    sys.exit(0)
if not isinstance(members, dict):
    sys.exit(0)
for member in members.values():
    if not isinstance(member, dict):
        continue
    name = str(member.get("name") or "").strip()
    if name:
        label = member.get("title") or member.get("role") or ""
        print(name + "\t" + " ".join(str(label).split()))
PY
}

if [[ $picked -eq 0 ]]; then
  council=$(find_council || true)
  names=()
  if [[ -n "$council" ]]; then
    if command -v python3 >/dev/null 2>&1; then
      while IFS= read -r row; do
        [[ -n "$row" ]] && names+=("$row")
      done < <(list_members "$council")
    else
      echo "wclaude: python3 not found; council members not listed" >&2
    fi
  fi
  count=${#names[@]}

  # `-c <member>` was the launcher's old pin; claude reads -c as --continue and the name as a prompt.
  prev=""
  for arg in "$@"; do
    if [[ "$prev" == "-c" && -n "$arg" ]]; then
      for row in ${names[@]+"${names[@]}"}; do
        if [[ "$(printf '%s' "${row%%$'\t'*}" | tr '[:upper:]' '[:lower:]')" == "$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')" ]]; then
          echo "wclaude: -c goes to claude (--continue); did you mean --as $arg?" >&2
        fi
      done
    fi
    prev=$arg
  done

  if [[ -n "$council" ]]; then
    shown=$council
    case $council in "$HOME"/*) shown="~${council#"$HOME"}" ;; esac
    echo "Companion for this session (from $shown):" >&2
  else
    echo "Companion for this session (no .weside/council.json found):" >&2
  fi
  i=1
  for row in ${names[@]+"${names[@]}"}; do
    printf '  %2d) %-12s %s\n' "$i" "${row%%$'\t'*}" "${row#*$'\t'}" >&2
    i=$((i + 1))
  done
  other=$i
  printf '  %2d) %s\n' "$other" "other name..." >&2
  printf '  %2d) %s\n' 0 "no companion" >&2

  printf '> ' >&2
  IFS= read -r choice || { echo "wclaude: no choice read" >&2; exit 1; }
  choice=$(printf '%s' "$choice" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  if [[ -z "$choice" ]]; then
    echo "wclaude: no choice; type a number or a name" >&2
    exit 1
  elif [[ "$choice" == "0" ]]; then
    pick=""
  elif [[ "$choice" =~ ^[0-9]+$ ]]; then
    n=$((10#$choice))
    if ((n >= 1 && n <= count)); then
      row=${names[$((n - 1))]}
      pick=${row%%$'\t'*}
    elif ((n == other)); then
      printf 'Name: ' >&2
      IFS= read -r pick || pick=""
      pick=$(printf '%s' "$pick" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [[ -n "$pick" ]] || { echo "wclaude: no name given" >&2; exit 1; }
    else
      echo "wclaude: no entry $choice" >&2
      exit 1
    fi
  else
    pick=$choice # a typed name works too
  fi
fi

if [[ -n "$pick" ]]; then
  # --name, not only the SessionStart hook's sessionTitle: the hook titles the prompt bar and
  # transcript, but the session list (`claude agents`) keeps its derived name (`<dir>-<hex>`).
  named=0
  for arg in "$@"; do
    case $arg in -n | --name | --name=*) named=1 ;; esac
  done
  if [[ $named -eq 0 ]]; then
    set -- --name "$pick" "$@"
  fi
  printf '%s WESIDE_COMPANION=%q %q' '->' "$pick" "$launch" >&2
  printf ' %q' "$@" >&2
  printf '\n' >&2
  WESIDE_COMPANION="$pick" exec "$launch" "$@"
else
  printf '%s %q' '->' "$launch" >&2
  [[ $# -gt 0 ]] && printf ' %q' "$@" >&2
  printf ' (no companion)\n' >&2
  WESIDE_COMPANION="" exec "$launch" "$@"
fi
