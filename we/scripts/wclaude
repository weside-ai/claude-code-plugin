#!/usr/bin/env bash
# wclaude — start Claude Code as a weside Companion (references/companion-session.md).
# Lists the members of the repo's crew (.weside/crew.json or the config.json pointer, via crew.py),
# then runs `WESIDE_COMPANION=<Name> claude --name <Name> <your args>` (no --name if you pass one).
#   wclaude                 menu, then claude
#   wclaude --resume        menu, then claude --resume (every other argument goes to claude)
#   wclaude -c              menu, then claude -c (claude's own --continue)
#   wclaude --as <Name> ... no menu; the rest goes to claude
#   wclaude --pin ...       start through $WCLAUDE_PIN instead of claude (combines with --as)
#   wclaude --start [--fresh]  the crew's main companion (references/companion-session.md § Launch and pin)
# Choice 0 starts claude with the companion pin cleared (WESIDE_COMPANION empty = no companion).
# Every session it starts is a master: WE_ROLE=master. Without --pin it runs on the same login as a
# plain `claude` and follows your account switcher. WCLAUDE_PIN names one executable that takes
# claude's arguments and holds the session on one account (e.g. a claude-swap profile); --pin
# without it is refused.
# Portable to macOS bash 3.2: no mapfile, no empty-array expansion under `set -u`.
set -euo pipefail

usage() {
  echo "usage: wclaude [--as <Name>] [--pin] [claude arguments...]" >&2
  exit 2
}

pick=""
picked=0
pin=0
start=0
fresh=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --as)
      [[ $# -ge 2 && -n "$2" ]] || usage
      pick=$2
      picked=1
      shift 2
      ;;
    --pin)
      pin=1
      shift
      ;;
    --start)
      start=1
      shift
      ;;
    --fresh)
      fresh=--fresh
      shift
      ;;
    *) break ;;
  esac
done
launch=claude
if [[ $pin -eq 1 ]]; then
  [[ -n "${WCLAUDE_PIN:-}" ]] || { echo "wclaude: --pin needs WCLAUDE_PIN (the command that pins an account)" >&2; exit 2; }
  launch=$WCLAUDE_PIN
fi
export WE_ROLE=master

# crew.py next to this script (the plugin's copy), else the install Claude Code uses in this
# directory (the installed copy in ~/.local/bin): the project-scope `we` entry of
# installed_plugins.json for the directory or its nearest ancestor, else the user-scope entry,
# never the newest folder of the cache (two crews, AC7); references/companion-session.md § Crew.
crew_script() {
  local here
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  if [[ -f "$here/crew.py" ]]; then
    echo "$here/crew.py"
    return 0
  fi
  # we-install-resolver (scripts/validate-consistency.py keeps every copy equal)
  python3 -c 'if True:
    import json, os, sys
    f = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "plugins", "installed_plugins.json")
    want, run = sys.argv[1], "--exec" in sys.argv[2:3]
    try:
        rows = [e for k, v in json.load(open(f))["plugins"].items() if k.split("@")[0] == "we" for e in v]
    except Exception:
        sys.stderr.write("we plugin: " + f + " not readable; the plugin is not resolved\n")
        sys.exit(0 if run else 1)
    here = os.path.realpath(os.getcwd())
    def holds(e):
        p = os.path.realpath(e.get("projectPath") or "/nonexistent")
        return e.get("scope") in ("project", "local") and (here == p or here.startswith(p.rstrip("/") + "/"))
    near = sorted((e for e in rows if holds(e)), key=lambda e: len(os.path.realpath(e["projectPath"])))
    pick = (near or [e for e in rows if e.get("scope") == "user"] or [None])[-1]
    if pick is None:
        sys.stderr.write("we plugin: no we install in " + f + "\n")
        sys.exit(0 if run else 1)
    path = os.path.join(pick["installPath"], want)
    if run:
        os.execvp(sys.executable, [sys.executable, path] + sys.argv[3:])
    print(path)
' scripts/crew.py || true
}

# --start: scripts/start.py plan decides who, where, pinned or not, which session.
if [[ $start -eq 1 ]]; then
  [[ $picked -eq 0 ]] || { echo "wclaude: --start takes the companion from the crew; drop --as" >&2; exit 2; }
  command -v python3 >/dev/null 2>&1 || { echo "wclaude: --start needs python3" >&2; exit 1; }
  resolver=$(crew_script)
  [[ -n "$resolver" ]] || { echo "wclaude: --start needs the we plugin (crew.py not found)" >&2; exit 1; }
  row=$(python3 "$(dirname "$resolver")/start.py" plan ${fresh:+"$fresh"}) || exit 1
  IFS=$'\t' read -r pick s_pin s_dir s_sid <<<"$row"
  picked=1
  if [[ "$s_pin" == 1 && $pin -eq 0 ]]; then
    pin=1
    [[ -n "${WCLAUDE_PIN:-}" ]] || { echo "wclaude: the crew pins $pick, but WCLAUDE_PIN is not set" >&2; exit 2; }
    launch=$WCLAUDE_PIN
  fi
  cd "$s_dir"
  export WE_START=1
  if [[ -n "$s_sid" ]]; then
    echo "wclaude: $pick resumes its last session $s_sid in $s_dir" >&2
    set -- --resume "$s_sid" "$@"
  else
    echo "wclaude: $pick starts fresh in $s_dir" >&2
  fi
  set -- "$@" "/we:start"
elif [[ -n "$fresh" ]]; then
  echo "wclaude: --fresh goes with --start" >&2
  exit 2
fi

if [[ $picked -eq 0 ]]; then
  crew=""
  names=()
  if command -v python3 >/dev/null 2>&1; then
    resolver=$(crew_script)
    if [[ -n "$resolver" ]]; then
      crew=$(python3 "$resolver" path 2>/dev/null || true)
      if [[ -n "$crew" ]]; then
        # One line per named member: "<name>\t<title, else role>".
        while IFS= read -r row; do
          [[ -n "$row" ]] && names+=("$row")
        done < <(python3 "$resolver" members || true)
      fi
    else
      echo "wclaude: crew.py not found (we plugin absent); crew not listed" >&2
    fi
  else
    echo "wclaude: python3 not found; crew not listed" >&2
  fi
  count=${#names[@]}

  # `-c <member>` was the launcher's old pin; claude reads -c as --continue and the name as a prompt.
  prev=""
  for arg in "$@"; do
    if [[ "$prev" == "-c" && -n "$arg" ]]; then
      for row in ${names[@]+"${names[@]}"}; do
        if [[ "$(printf '%s' "${row%%$'\t'*}" | tr '[:upper:]' '[:lower:]')" == "$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')" ]]; then
          echo "wclaude: -c goes to claude (--continue); did you mean --as $arg?" >&2
        fi
      done
    fi
    prev=$arg
  done

  if [[ -n "$crew" ]]; then
    shown=$crew
    case $crew in "$HOME"/*) shown="~${crew#"$HOME"}" ;; esac
    echo "Companion for this session (from $shown):" >&2
  else
    echo "Companion for this session (no .weside/crew.json found):" >&2
  fi
  i=1
  for row in ${names[@]+"${names[@]}"}; do
    printf '  %2d) %-12s %s\n' "$i" "${row%%$'\t'*}" "${row#*$'\t'}" >&2
    i=$((i + 1))
  done
  other=$i
  printf '  %2d) %s\n' "$other" "other name..." >&2
  printf '  %2d) %s\n' 0 "no companion" >&2

  printf '> ' >&2
  IFS= read -r choice || { echo "wclaude: no choice read" >&2; exit 1; }
  choice=$(printf '%s' "$choice" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  if [[ -z "$choice" ]]; then
    echo "wclaude: no choice; type a number or a name" >&2
    exit 1
  elif [[ "$choice" == "0" ]]; then
    pick=""
  elif [[ "$choice" =~ ^[0-9]+$ ]]; then
    n=$((10#$choice))
    if ((n >= 1 && n <= count)); then
      row=${names[$((n - 1))]}
      pick=${row%%$'\t'*}
    elif ((n == other)); then
      printf 'Name: ' >&2
      IFS= read -r pick || pick=""
      pick=$(printf '%s' "$pick" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [[ -n "$pick" ]] || { echo "wclaude: no name given" >&2; exit 1; }
    else
      echo "wclaude: no entry $choice" >&2
      exit 1
    fi
  else
    pick=$choice # a typed name works too
  fi
fi

if [[ -n "$pick" ]]; then
  # --name, not only the SessionStart hook's sessionTitle: the hook titles the prompt bar and
  # transcript, but the session list (`claude agents`) keeps its derived name (`<dir>-<hex>`).
  named=0
  for arg in "$@"; do
    case $arg in -n | --name | --name=*) named=1 ;; esac
  done
  if [[ $named -eq 0 ]]; then
    set -- --name "$pick" "$@"
  fi
  printf '%s WESIDE_COMPANION=%q %q' '->' "$pick" "$launch" >&2
  printf ' %q' "$@" >&2
  printf '\n' >&2
  WESIDE_COMPANION="$pick" exec "$launch" "$@"
else
  printf '%s %q' '->' "$launch" >&2
  [[ $# -gt 0 ]] && printf ' %q' "$@" >&2
  printf ' (no companion)\n' >&2
  WESIDE_COMPANION="" exec "$launch" "$@"
fi
